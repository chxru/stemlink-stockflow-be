meta {
  name: Stock Summary
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/stock-summary?warehouse=all&month=2026-08
  body: none
  auth: none
}

params:query {
  warehouse: all
  month: 2026-08
}

docs {
  `warehouse`: `all` or a warehouse code (WH-1). `month`: YYYY-MM, defaults to the current month.
}
