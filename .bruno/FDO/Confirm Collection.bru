post {
  url: {{baseUrl}}/api/fdo/distribution-runs/{{runId}}/collection
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Needs `token`: a Clerk session token of an FDO (see README, "Calling the API with a token").
