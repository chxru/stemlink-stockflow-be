meta {
  name: List My Stock Requests
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/fdo/stock-requests
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Needs `token`: a Clerk session token of an FDO (see README, "Calling the API with a token").
  Returns the signed-in FDO's own requests.
}
