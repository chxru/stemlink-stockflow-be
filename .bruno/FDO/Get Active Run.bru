meta {
  name: Get Active Run
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/fdo/distribution-runs/active
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Needs `token`: a Clerk session token of an FDO (see README, "Calling the API with a token").
