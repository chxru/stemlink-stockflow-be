{
	"format_on_save": "on",
	"prettier": {
		"allowed": false
	},
	"formatter": {
		"language_server": {
			"name": "biome"
		}
	},
	"code_actions_on_format": {
		"source.fixAll.biome": true,
		"source.organizeImports.biome": true
	},
	"languages": {
		"JavaScript": {
			"language_servers": ["biome", "!eslint", "..."]
		},
		"TypeScript": {
			"language_servers": ["biome", "!eslint", "..."]
		},
		"TSX": {
			"language_servers": ["biome", "!eslint", "..."]
		},
		"JSON": {
			"language_servers": ["biome", "..."]
		},
		"JSONC": {
			"language_servers": ["biome", "..."]
		}
	}
}
